# Crash logs
crash.log
crash.log.*

# Terraform CLI override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Sensitive local files
*.pem
*.key
.env
.env.*

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
